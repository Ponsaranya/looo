# detect.py
import re

def detect_module(text):
    text = text.strip()
    text_lower = text.lower()

    parts = {
        "faq": None,
        "recommendation": None
    }

    # Patterns for recommendation
    rec_pattern = r"(suggest|recommend).*"

    # Find recommendation sentence
    rec_match = re.search(rec_pattern, text_lower)

    if rec_match:
        # Extract recommendation part (original text)
        rec_text = text[rec_match.start():].strip()
        parts["recommendation"] = rec_text

        # Remove recommendation from text → remaining is FAQ
        faq_text = re.sub(rec_pattern, "", text, flags=re.IGNORECASE).strip()

        if faq_text:
            parts["faq"] = faq_text
    else:
        # Only FAQ
        parts["faq"] = text

    return parts

