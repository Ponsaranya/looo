import re

def detect_module(text):
    text_lower = text.lower()
    intents = []

    has_customer_id = bool(re.search(r'\bc\d{7}\b', text_lower))
    has_recommend = "recommend" in text_lower or "suggest" in text_lower

    if has_customer_id or has_recommend:
        intents.append("recommendation")

    intents.append("faq")

    return intents


